# ============================================================
# PLANTILLA de variables de entorno — copiar a .env y rellenar
#
#   cp .env.example .env
#
# .env está en .gitignore: NO subir secretos al repositorio.
# Lo lee docker-compose para inyectar config a los contenedores.
# ============================================================

# ── Base de datos (PostgreSQL local) ─────────────────────────
DB_NAME=utec_labs
DB_USER=utec_admin
DB_PASSWORD=CAMBIAR_DB_PASSWORD

# ── Google OAuth2 ────────────────────────────────────────────
# Client ID de Google Cloud Console (termina en .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=CAMBIAR_GOOGLE_CLIENT_ID

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CAMBIAR_JWT_SECRET_MIN_256_BITS

# ── Servicios locales (contenedores) — desechables ───────────
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD
RABBITMQ_USER=utec_rabbit
RABBITMQ_PASSWORD=CAMBIAR_RABBITMQ_PASSWORD
RABBITMQ_VHOST=utec

# ── Correo (Gmail SMTP) — SENSIBLE ───────────────────────────
# App Password de 16 caracteres generado en la cuenta de Google.
MAIL_USERNAME=conceptlab@utec.edu.pe
MAIL_PASSWORD=CAMBIAR_APP_PASSWORD_GMAIL
